<odoo>
    <!-- LIST VIEW: หน้ารายการ -->
    <record id="study_note_view_list" model="ir.ui.view">
        <field name="name">study.note.list</field>
        <field name="model">study.note</field>
        <field name="arch" type="xml">
            <!-- decoration-*: ใส่สีทั้งแถวตามเงื่อนไข -->
            <list decoration-muted="done" decoration-danger="priority == '3' and not done">
                <field name="priority" widget="priority"/>
                <field name="date"/>
                <field name="name"/>
                <field name="word_count"/>
                <field name="done" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW: หน้ากรอก/แก้ไขทีละรายการ -->
    <record id="study_note_view_form" model="ir.ui.view">
        <field name="name">study.note.form</field>
        <field name="model">study.note</field>
        <field name="arch" type="xml">
            <form>
                <!-- header: แถบปุ่มด้านบน; invisible = ซ่อนปุ่มตามเงื่อนไข -->
                <header>
                    <button name="action_mark_done" string="Mark as Done" type="object"
                            class="btn-primary" invisible="done"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="not done"/>
                </header>
                <sheet>
                    <!-- ribbon มุมขวาบน แสดงเมื่อ done -->
                    <widget name="web_ribbon" title="Done" bg_color="text-bg-success" invisible="not done"/>
                    <div class="oe_title">
                        <h1>
                            <field name="priority" widget="priority" class="me-3"/>
                            <field name="name" placeholder="Note title..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="word_count"/>
                            <field name="done" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Write your note..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW: ช่องค้นหา + ตัวกรอง -->
    <record id="study_note_view_search" model="ir.ui.view">
        <field name="name">study.note.search</field>
        <field name="model">study.note</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <filter name="filter_todo" string="To Do" domain="[('done', '=', False)]"/>
                <filter name="filter_done" string="Done" domain="[('done', '=', True)]"/>
                <separator/>
                <filter name="filter_urgent" string="Urgent" domain="[('priority', '=', '3')]"/>
            </search>
        </field>
    </record>

    <record id="study_note_action" model="ir.actions.act_window">
        <field name="name">Study Notes</field>
        <field name="res_model">study.note</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="study_note_menu_root" name="Study Notes" sequence="10"/>
    <menuitem id="study_note_menu_notes" name="Notes"
              parent="study_note_menu_root" action="study_note_action" sequence="10"/>
</odoo>
